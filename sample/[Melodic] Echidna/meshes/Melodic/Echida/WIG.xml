	<!-- cloth -->
	<bone-default>
		<margin-multiplier>0.1</margin-multiplier>
	</bone-default>
	
	<bone-default>
		<mass>1</mass>
		<inertia x="1" y="1" z="1" />
		<centerOfMassTransform>
			<basis x="0" y="0" z="0" w="1" />
			<origin x="0" y="0" z="0" />
		</centerOfMassTransform>
		<linearDamping>0.0</linearDamping>
		<angularDamping>0.0</angularDamping>
		<friction>0.0</friction>
		<restitution>0.0</restitution>
	</bone-default>

	
	<bone name="kurwaAL_01"/>	
	<bone name="kurwaAL_02"/>		

	<bone name="kurwaAR_01"/>	
	<bone name="kurwaAR_02"/>		

	
	<generic-constraint-default>
		<frameInB>
			<basis x="0" y="0" z="0" w="1" />
			<origin x="0" y="0" z="0" />
		</frameInB>
		<useLinearReferenceFrameA>false</useLinearReferenceFrameA>
		<linearLowerLimit x="0" y="0" z="0" />
		<linearUpperLimit x="0.0" y="0.0" z="0.0" />
		<angularLowerLimit x="-0.2" y="-0.2" z="-0.2" />
		<angularUpperLimit x="0.2" y="0.2" z="0.2" />
		<linearStiffness x="0" y="0" z="0" />
		<angularStiffness x="0" y="0" z="0" />
		<linearDamping x="0" y="0" z="0" />
		<angularDamping x="0" y="0" z="0" />
		<linearEquilibrium x="0" y="0" z="0" />
		<angularEquilibrium x="0" y="0" z="0" />
	</generic-constraint-default>
	
	
	<constraint-group>
		<generic-constraint bodyA="kurwaAL_01" bodyB="kurwaAL_00"/>
		<generic-constraint bodyA="kurwaAL_02" bodyB="kurwaAL_01"/>
	</constraint-group> 
	<constraint-group>
		<generic-constraint bodyA="kurwaAR_01" bodyB="kurwaAR_00"/>
		<generic-constraint bodyA="kurwaAR_02" bodyB="kurwaAR_01"/>
	</constraint-group> 	

	

  <generic-constraint-default>
    <frameInLerp>
			<translationLerp>0</translationLerp>
			<rotationLerp>0</rotationLerp>
    </frameInLerp>
	<linearLowerLimit x="-1.5" y="-1.5" z="-1.5"/>
    <linearUpperLimit x="1.5" y="1.5" z="1.5"/>
    <angularLowerLimit x="-5" y="-5" z="-5"/>
    <angularUpperLimit x="5" y="5" z="5"/>
	<linearStiffness x="0" y="0" z="0"/>
    <angularStiffness x="0" y="0" z="0"/>
  </generic-constraint-default>
 
